ngOption(o=>o.setName('emoji').setDescription('Emoji, como ✅').setRequired(true)).addRoleOption(o=>o.setName('cargo').setDescription('Cargo entregue').setRequired(true)).setDefaultMemberPermissions(PermissionFlagsBits.ManageRoles),
