const client = new Client({intents:[GatewayIntentBits.Guilds,GatewayIntentBits.GuildMessages,GatewayIntentBits.MessageContent,GatewayIntentBits.GuildMessageReactions,...(process.env.ENABLE_MEMBERS_INTENT==='true'?[GatewayIntentBits.GuildMembers]:[])],partials:[Partials.Channel,Partials.Message,Partials.Reaction,Partials.User]});
function ensure(g,u){db.prepare('INSERT OR IGNORE INTO users(guild_id,user_id) VALUES(?,?)').run(g,u)} function addCoins(g,u,n,r){ensure(g,u);db.prepare('UPDATE users SET coins=coins+? WHERE guild_id=? AND user_id=?').run(n,g,u);db.prepare('INSERT INTO transactions(guild_id,user_id,amount,reason,created_at) VALUES(?,?,?,?,?)').run(g,u,n,r,Date.now())} function coins(g,u){ensure(g,u);return db.prepare('SELECT coins FROM users WHERE guild_id=? AND user_id=?').get(g,u).coins} function cur(g){return db.prepare('SELECT currency FROM config WHERE guild_id=?').get(g)?.currency||'moedas'} async function log(g,t){const id=db.prepare('SELECT log_channel FROM config WHERE guild_id=?').get(g.id)?.log_channel;const ch=id&&g.channels.cache.get(id);if(ch)ch.send({embeds:[new EmbedBuilder().setColor(0x5865f2).setDescription(t).setTimestamp()]}).catch(()=>{})} async function counter(g){const id=db.prepare('SELECT counter_channel FROM config WHERE guild_id=?').get(g.id)?.counter_channel;const ch=id&&g.channels.cache.get(id);if(ch)ch.setName(`👥 Membros: ${g.memberCount}`).catch(()=>{})}
async function checkReminders(){for(const x of db.prepare('SELECT * FROM reminders WHERE sent=0 AND due_at<=?').all(Date.now())){const ch=client.channels.cache.get(x.channel_id);if(ch)await ch.send(`⏰ <@${x.user_id}> lembrete: **${x.message}**`).catch(()=>{});db.prepare('UPDATE reminders SET sent=1 WHERE id=?').run(x.id)}}
async function finishGiveaway(x){if(x.status!=='open')return;const ch=client.channels.cache.get(x.channel_id);let msg;try{msg=ch&&await ch.messages.fetch(x.message_id)}catch{}const users=msg?.reactions.cache.get('🎉')?await msg.reactions.cache.get('🎉').users.fetch():new Map();const pool=[...users.values()].filter(u=>!u.bot);pool.sort(()=>Math.random()-0.5);const winners=pool.slice(0,x.winners);db.prepare("UPDATE giveaways SET status='closed' WHERE id=?").run(x.id);if(ch)await ch.send(`🎉 **Sorteio #${x.id} encerrado!** Prêmio: **${x.prize}**\n${winners.length?winners.map(u=>u.toString()).join(', '):'Ninguém participou.'}`)}
async function checkGiveaways(){for(const x of db.prepare("SELECT * FROM giveaways WHERE status='open' AND ends_at<=?").all(Date.now()))await finishGiveaway(x)}
client.once(Events.ClientReady,async c=>{const rest=new REST({version:'10'}).setToken(token);const app=clientId||c.user.id;if(guildId)await rest.put(Routes.applicationGuildCommands(app,guildId),{body:cmds});else await rest.put(Routes.applicationCommands(app),{body:cmds});setInterval(()=>{checkGiveaways();checkReminders()},30000);console.log(`Online como ${c.user.tag}`);});
client.on(Events.GuildMemberAdd,async m=>{const a=db.prepare('SELECT autorole_id FROM config WHERE guild_id=?').get(m.guild.id)?.autorole_id;if(a){const r=m.guild.roles.cache.get(a);if(r&&m.guild.members.me?.permissions.has(PermissionFlagsBits.ManageRoles)&&r.position<m.guild.members.me.roles.highest.position)m.roles.add(r).catch(()=>{})}const id=db.prepare('SELECT welcome_channel FROM config WHERE guild_id=?').get(m.guild.id)?.welcome_channel;const ch=id&&m.guild.channels.cache.get(id);if(ch)ch.send(`Bem-vindo(a), ${m}! Leia as regras e divirta-se.`).catch(()=>{});await counter(m.guild);await log(m.guild,`Entrou: ${m.user.tag}`)}); client.on(Events.GuildMemberRemove,async m=>{await counter(m.guild);await log(m.guild,`Saiu: ${m.user.tag}`)});
const xpCooldown=new Map();
client.on(Events.MessageCreate,m=>{if(!m.guild||m.author.bot)return;ensure(m.guild.id,m.author.id);const key=`${m.guild.id}:${m.author.id}`,now=Date.now();if(!xpCooldown.has(key)||xpCooldown.get(key)<now){xpCooldown.set(key,now+60000);const x=db.prepare('SELECT xp,level FROM users WHERE guild_id=? AND user_id=?').get(m.guild.id,m.author.id);const gain=Math.floor(Math.random()*11)+15,newXp=x.xp+gain,newLevel=Math.floor(newXp/100);db.prepare('UPDATE users SET xp=?,level=? WHERE guild_id=? AND user_id=?').run(newXp,newLevel,m.guild.id,m.author.id);if(newLevel>x.level)m.channel.send(`🎉 ${m.author}, você alcançou o nível **${newLevel}**!`).catch(()=>{})}for(const x of db.prepare("SELECT * FROM missions WHERE guild_id=? AND kind='messages'").all(m.guild.id)){db.prepare('INSERT OR IGNORE INTO progress(guild_id,user_id,mission_id) VALUES(?,?,?)').run(m.guild.id,m.author.id,x.id);db.prepare('UPDATE progress SET value=value+1 WHERE guild_id=? AND user_id=? AND mission_id=? AND claimed=0').run(m.guild.id,m.author.id,x.id)}});
client.on(Events.MessageReactionAdd,async(r,u)=>{if(u.bot)return;try{if(r.partial)await r.fetch();const x=db.prepare('SELECT role_id FROM reaction_roles WHERE guild_id=? AND channel_id=? AND message_id=? AND emoji=?').get(r.message.guild.id,r.message.channel.id,r.message.id,r.emoji.name||r.emoji.id);if(!x)return;const member=await r.message.guild.members.fetch(u.id),role=r.message.guild.roles.cache.get(x.role_id);if(role&&role.position<r.message.guild.members.me.roles.highest.position)await member.roles.add(role)}catch(e){console.error('reaction role add',e.message)}});
client.on(Events.MessageReactionRemove,async(r,u)=>{if(u.bot)return;try{if(r.partial)await r.fetch();const x=db.prepare('SELECT role_id FROM reaction_roles WHERE guild_id=? AND channel_id=? AND message_id=? AND emoji=?').get(r.message.guild.id,r.message.channel.id,r.message.id,r.emoji.name||r.emoji.id);if(!x)return;const member=await r.message.guild.members.fetch(u.id),role=r.message.guild.roles.cache.get(x.role_id);if(role)await member.roles.remove(role)}catch(e){console.error('reaction role remove',e.message)}});
client.on(Events.InteractionCreate,async i=>{try{if(i.isButton()&&i.customId.startsWith('event_join_')){const id=Number(i.customId.slice(11)),e=db.prepare("SELECT * FROM events WHERE id=? AND guild_id=? AND status='open'").get(id,i.guild.id);if(!e)return i.reply({content:'Este evento não está mais disponível.',ephemeral:true});db.prepare('INSERT OR IGNORE INTO event_members(event_id,user_id,joined_at) VALUES(?,?,?)').run(id,i.user.id,Date.now());return i.reply({content:`Você confirmou presença no evento **${e.title}**.`,ephemeral:true})}if(i.isButton()&&i.customId.startsWith('event_leave_')){const id=Number(i.customId.slice(11));db.prepare('DELETE FROM event_members WHERE event_id=? AND user_id=?').run(id,i.user.id);return i.reply({content:'Sua presença foi removida.',ephemeral:true})}if(i.isButton()&&i.customId==='close_ticket'){await i.reply('Ticket fechado.');db.prepare('DELETE FROM tickets WHERE channel_id=?').run(i.channel.id);setTimeout(()=>i.channel?.delete().catch(()=>{}),1200);return}if(i.isButton()&&i.customId.startsWith('panel_')){const a=i.customId.slice(6);const m={economia:'`/saldo` · `/nivel` · `/ranking-xp` · `/trabalhar` · `/daily` · `/ranking` · `/pagar`',loja:'`/loja` · `/comprar` · `/criar-recompensa`',missoes:'`/missoes` · `/criar-missao`',tickets:'`/ticket` · `/fechar` · `/ticket-assumir` · `/transcript`',moderacao:'`/limpar` · `/banir` · `/expulsar` · `/avisar` · `/avisos` · `/silenciar` · `/trancar` · `/destrancar` · `/modo-lento`',eventos:'`/evento-criar` · `/eventos` · `/evento-cancelar` · `/sorteio-criar` · `/sorteios` · `/sorteio-encerrar` · `/enquete` · `/sugestao` · `/configurar-cargo-reacao` · `/estatisticas`',config:'`/configuracao` · `/configurar-log` · `/configurar-boasvindas` · `/configurar-cargo-auto` · `/configurar-sugestoes` · `/configurar-cargo-reacao` · `/configurar-moeda` · `/configurar-regras` · `/criar-call` · `/configurar-contador`'};return i.reply({content:`**${a}**\n${m[a]||'Use os comandos do bot.'}`,ephemeral:true})}if(!i.isChatInputCommand())return;const g=i.guild.id,u=i.user.id,n=i.commandName;
if(n==='painel'){const r1=new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId('panel_economia').setLabel('Economia').setStyle(ButtonStyle.Primary),new ButtonBuilder().setCustomId('panel_loja').setLabel('Loja').setStyle(ButtonStyle.Success),new ButtonBuilder().setCustomId('panel_missoes').setLabel('Missões').setStyle(ButtonStyle.Secondary));const r2=new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId('panel_tickets').setLabel('Tickets').setStyle(ButtonStyle.Primary),new ButtonBuilder().setCustomId('panel_moderacao').setLabel('Moderação').setStyle(ButtonStyle.Danger),new ButtonBuilder().setCustomId('panel_eventos').setLabel('Eventos e voz').setStyle(ButtonStyle.Secondary));const r3=new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId('panel_config').setLabel('Configuração').setStyle(ButtonStyle.Secondary));return i.reply({content:'**Painel central do servidor**\nEscolha uma área:',components:[r1,r2,r3]})}
if(n==='nivel'){const t=i.options.getUser('usuario')||i.user;ensure(g,t.id);const x=db.prepare('SELECT xp,level FROM users WHERE guild_id=? AND user_id=?').get(g,t.id);return i.reply(`${t} está no nível **${x.level}**, com **${x.xp%100}/100 XP** para o próximo nível.`)} if(n==='ranking-xp'){const a=db.prepare('SELECT user_id,xp,level FROM users WHERE guild_id=? ORDER BY xp DESC LIMIT 10').all(g);return i.reply('**Ranking de XP**\n'+(a.map((x,j)=>`${j+1}. <@${x.user_id}> — nível ${x.level} (${x.xp} XP)`).join('\n')||'Sem dados.'))} if(n==='saldo')return i.reply(`Você tem **${coins(g,u)} ${cur(g)}**.`); if(n==='trabalhar'){ensure(g,u);const x=db.prepare('SELECT work_at FROM users WHERE guild_id=? AND user_id=?').get(g,u);if(x.work_at>Date.now()-3600000)return i.reply({content:'Você já trabalhou nesta hora.',ephemeral:true});const v=Math.floor(Math.random()*101)+50;db.prepare('UPDATE users SET work_at=? WHERE guild_id=? AND user_id=?').run(Date.now(),g,u);addCoins(g,u,v,'trabalho');return i.reply(`Você recebeu **${v} ${cur(g)}**.`)} if(n==='daily'){ensure(g,u);const x=db.prepare('SELECT daily_at FROM users WHERE guild_id=? AND user_id=?').get(g,u);if(x.daily_at>Date.now()-86400000)return i.reply({content:'Daily ainda não disponível.',ephemeral:true});addCoins(g,u,500,'daily');db.prepare('UPDATE users SET daily_at=? WHERE guild_id=? AND user_id=?').run(Date.now(),g,u);return i.reply(`Recompensa diária: **500 ${cur(g)}**.`)} if(n==='ranking'){const a=db.prepare('SELECT user_id,coins FROM users WHERE guild_id=? ORDER BY coins DESC LIMIT 10').all(g);return i.reply('**Ranking**\n'+(a.map((x,j)=>`${j+1}. <@${x.user_id}> — ${x.coins}`).join('\n')||'Sem dados.'))} if(n==='pagar'){const t=i.options.getUser('usuario'),v=i.options.getInteger('valor');if(t.bot||t.id===u||coins(g,u)<v)return i.reply({content:'Destinatário inválido ou saldo insuficiente.',ephemeral:true});addCoins(g,u,-v,`pagamento para ${t.id}`);addCoins(g,t.id,v,`pagamento de ${u}`);return i.reply(`Transferência concluída: ${t} recebeu **${v}**.`)}
if(n==='anunciar-missao'){const titulo=i.options.getString('titulo'),det=i.options.getString('detalhes'),link=i.options.getString('link');const ch=i.channel;if(!i.memberPermissions?.has(PermissionFlagsBits.ManageGuild))return i.reply({content:'Somente administradores podem anunciar missões.',ephemeral:true});await ch.send({content:'@everyone',allowedMentions:{parse:['everyone']},embeds:[new EmbedBuilder().setColor(0xfaa61a).setTitle('🎯 Nova missão disponível').setDescription(`**${titulo}**\n${det}${link?'\n\n[Mais informações]('+link+')':''}`).setFooter({text:'Anúncio do Orb Missions Bot'}).setTimestamp()]});return i.reply({content:'Missão anunciada neste canal.',ephemeral:true})} if(n==='loja'){const a=db.prepare('SELECT * FROM shop WHERE guild_id=?').all(g);return i.reply(a.length?a.map(x=>`**#${x.id} — ${x.name}**: ${x.price} ${cur(g)} — <@&${x.role_id}>`).join('\n'):'Loja vazia.')} if(n==='comprar'){const x=db.prepare('SELECT * FROM shop WHERE guild_id=? AND id=?').get(g,i.options.getInteger('id'));if(!x)return i.reply({content:'Recompensa não encontrada.',ephemeral:true});const r=i.guild.roles.cache.get(x.role_id);if(!r||coins(g,u)<x.price||r.position>=i.guild.members.me.roles.highest.position)return i.reply({content:'Saldo insuficiente ou cargo não gerenciável.',ephemeral:true});addCoins(g,u,-x.price,`compra #${x.id}`);await i.member.roles.add(r);return i.reply(`Compra realizada: você recebeu ${r}.`)} if(n==='missoes'){const a=db.prepare('SELECT m.*,COALESCE(p.value,0) value,p.claimed FROM missions m LEFT JOIN progress p ON p.mission_id=m.id AND p.guild_id=? AND p.user_id=? WHERE m.guild_id=?').all(g,u,g);return i.reply(a.length?a.map(x=>`**#${x.id} ${x.name}** — ${Math.min(x.value,x.goal)}/${x.goal} — ${x.reward} moedas`).join('\n'):'Nenhuma missão cadastrada.')}
if(n==='ticket'){const me=i.guild.members.me;if(!me?.permissions.has(PermissionFlagsBits.ManageChannels))return i.reply({content:'Preciso de Gerenciar Canais.',ephemeral:true});const name=`ticket-${i.user.username.toLowerCase().replace(/[^a-z0-9-]/g,'-')}`.slice(0,90);if(i.guild.channels.cache.find(c=>c.name===name))return i.reply({content:'Você já possui um ticket.',ephemeral:true});const ch=await i.guild.channels.create({name,type:ChannelType.GuildText,permissionOverwrites:[{id:i.guild.roles.everyone.id,deny:[PermissionFlagsBits.ViewChannel]},{id:u,allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ReadMessageHistory]},{id:me.id,allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ManageChannels,PermissionFlagsBits.ReadMessageHistory]}]});db.prepare('INSERT INTO tickets(channel_id,guild_id,owner_id,opened_at) VALUES(?,?,?,?)').run(ch.id,g,u,Date.now());const row=new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId('close_ticket').setLabel('Fechar ticket').setStyle(ButtonStyle.Danger));await ch.send({content:`Olá ${i.user}, descreva seu problema.`,components:[row]});return i.reply({content:`Ticket criado: ${ch}`,ephemeral:true})} if(n==='fechar'){if(!i.channel.name.startsWith('ticket-'))return i.reply({content:'Use dentro de um ticket.',ephemeral:true});await i.reply('Fechando ticket...');return setTimeout(()=>i.channel.delete().catch(()=>{}),1000)}
if(n==='limpar'){const q=i.options.getInteger('quantidade');await i.channel.bulkDelete(q,true);return i.reply({content:`${q} mensagens apagadas.`,ephemeral:true})} if(n==='banir'||n==='expulsar'){const t=i.options.getMember('usuario'),r=i.options.getString('motivo')||'Sem motivo';if(!t)return i.reply({content:'Membro não encontrado.',ephemeral:true});if(n==='banir')await t.ban({reason:r});else await t.kick(r);await log(i.guild,`${n}: ${t.user.tag} — ${r}`);return i.reply('Ação executada.')} if(n==='avisar'){const t=i.options.getUser('usuario'),r=i.options.getString('motivo');db.prepare('INSERT INTO warnings(guild_id,user_id,moderator_id,reason,created_at) VALUES(?,?,?,?,?)').run(g,t.id,u,r,Date.now());await log(i.guild,`Aviso para ${t.tag}: ${r}`);return i.reply(`Aviso registrado para ${t.tag}.`)} if(n==='avisos'){const t=i.options.getUser('usuario'),a=db.prepare('SELECT reason,moderator_id,created_at FROM warnings WHERE guild_id=? AND user_id=? ORDER BY id DESC LIMIT 10').all(g,t.id);return i.reply({content:a.length?a.map((x,j)=>`${j+1}. ${x.reason} — <@${x.moderator_id}>`).join('\n'):`${t} não possui avisos.`,ephemeral:true})}
if(n==='configuracao'){const x=db.prepare('SELECT * FROM config WHERE guild_id=?').get(g)||{};return i.reply({embeds:[new EmbedBuilder().setColor(0x5865f2).setTitle(`Configuração de ${i.guild.name}`).addFields({name:'Logs',value:x.log_channel?`<#${x.log_channel}>`:'Não configurado',inline:true},{name:'Boas-vindas',value:x.welcome_channel?`<#${x.welcome_channel}>`:'Não configurado',inline:true},{name:'Cargo automático',value:x.autorole_id?`<@&${x.autorole_id}>`:'Não configurado',inline:true},{name:'Sugestões',value:x.suggestions_channel?`<#${x.suggestions_channel}>`:'Não configurado',inline:true},{name:'Moeda',value:x.currency||'moedas',inline:true},{name:'Regras',value:x.rules_text?'Configuradas':'Padrão',inline:true})],ephemeral:true})} if(n==='configurar-moeda'){const nome=i.options.getString('nome');db.prepare('INSERT INTO config(guild_id,currency) VALUES(?,?) ON CONFLICT(guild_id) DO UPDATE SET currency=excluded.currency').run(g,nome);return i.reply(`Moeda definida como **${nome}**.`)} if(n==='configurar-regras'){const texto=i.options.getString('texto');db.prepare('INSERT INTO config(guild_id,rules_text) VALUES(?,?) ON CONFLICT(guild_id) DO UPDATE SET rules_text=excluded.rules_text').run(g,texto);return i.reply('Regras atualizadas.')} if(n==='configurar-log'){const c=i.options.getChannel('canal');db.prepare('INSERT INTO config(guild_id,log_channel) VALUES(?,?) ON CONFLICT(guild_id) DO UPDATE SET log_channel=excluded.log_channel').run(g,c.id);return i.reply(`Logs definidos em ${c}.`)} if(n==='configurar-boasvindas'){const c=i.options.getChannel('canal');db.prepare('INSERT INTO config(guild_id,welcome_channel) VALUES(?,?) ON CONFLICT(guild_id) DO UPDATE SET welcome_channel=excluded.welcome_channel').run(g,c.id);return i.reply(`Boas-vindas definidas em ${c}.`)} if(n==='configurar-cargo-auto'){const r=i.options.getRole('cargo');if(r.position>=i.guild.members.me.roles.highest.position)return i.reply({content:'Coloque o cargo abaixo do meu cargo.',ephemeral:true});db.prepare('INSERT INTO config(guild_id,autorole_id) VALUES(?,?) ON CONFLICT(guild_id) DO UPDATE SET autorole_id=excluded.autorole_id').run(g,r.id);return i.reply(`Cargo automático: ${r}.`)} if(n==='configurar-sugestoes'){const c=i.options.getChannel('canal');db.prepare('INSERT INTO config(guild_id,suggestions_channel) VALUES(?,?) ON CONFLICT(guild_id) DO UPDATE SET suggestions_channel=excluded.suggestions_channel').run(g,c.id);return i.reply(`Sugestões definidas em ${c}.`)} if(n==='sugestao'){const text=i.options.getString('texto'),id=db.prepare('SELECT suggestions_channel FROM config WHERE guild_id=?').get(g)?.suggestions_channel,c=id&&i.guild.channels.cache.get(id);if(!c)return i.reply({content:'Configure o canal primeiro.',ephemeral:true});const m=await c.send({embeds:[new EmbedBuilder().setColor(0x57f287).setTitle('Nova sugestão').setDescription(text).setFooter({text:i.user.tag})]});await m.react('✅');await m.react('❌');return i.reply({content:`Sugestão enviada em ${c}.`,ephemeral:true})} if(n==='enquete'){const q=i.options.getString('pergunta'),m=await i.channel.send({embeds:[new EmbedBuilder().setColor(0x5865f2).setTitle('Enquete').setDescription(q)]});await m.react('✅');await m.react('❌');return i.reply({content:'Enquete criada.',ephemeral:true})}
if(n==='regras'){const r=db.prepare('SELECT rules_text FROM config WHERE guild_id=?').get(g)?.rules_text||'Respeite todos, não faça spam e siga a equipe.';return i.reply({embeds:[new EmbedBuilder().setTitle(`Regras de ${i.guild.name}`).setDescription(r)]})} if(n==='evento-criar'){const titulo=i.options.getString('titulo'),descricao=i.options.getString('descricao'),inicio=Date.now()+i.options.getInteger('minutos')*60000;const e=db.prepare('INSERT INTO events(guild_id,channel_id,title,description,starts_at,created_by) VALUES(?,?,?,?,?,?)').run(g,i.channel.id,titulo,descricao,inicio,u);const id=e.lastInsertRowid;const row=new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId(`event_join_${id}`).setLabel('Vou participar').setStyle(ButtonStyle.Success),new ButtonBuilder().setCustomId(`event_leave_${id}`).setLabel('Não vou mais').setStyle(ButtonStyle.Secondary));const m=await i.channel.send({embeds:[new EmbedBuilder().setColor(0x57f287).setTitle(`📅 Evento #${id}: ${titulo}`).setDescription(`${descricao}\n\nComeça: <t:${Math.floor(inicio/1000)}:F>\nParticipantes: **0**`).setFooter({text:'Use os botões para confirmar presença'})],components:[row]});db.prepare('UPDATE events SET message_id=? WHERE id=?').run(m.id,id);return i.reply({content:`Evento #${id} criado.`,ephemeral:true})} if(n==='eventos'){const a=db.prepare("SELECT e.*,COUNT(em.user_id) total FROM events e LEFT JOIN event_members em ON em.event_id=e.id WHERE e.guild_id=? AND e.status='open' GROUP BY e.id ORDER BY e.starts_at").all(g);return i.reply(a.length?a.map(x=>`**#${x.id} — ${x.title}** · <t:${Math.floor(x.starts_at/1000)}:R> · ${x.total} participante(s)`).join('\n'):'Nenhum evento aberto.')} if(n==='evento-cancelar'){const id=i.options.getInteger('id');const e=db.prepare("SELECT * FROM events WHERE id=? AND guild_id=? AND status='open'").get(id,g);if(!e)return i.reply({content:'Evento não encontrado.',ephemeral:true});db.prepare("UPDATE events SET status='cancelled' WHERE id=?").run(id);const ch=client.channels.cache.get(e.channel_id);const m=ch&&await ch.messages.fetch(e.message_id).catch(()=>null);if(m)await m.edit({components:[],embeds:[new EmbedBuilder().setColor(0xed4245).setTitle(`Evento #${id} cancelado`).setDescription(e.title)]});return i.reply(`Evento #${id} cancelado.`)} if(n==='sorteio-criar'){const premio=i.options.getString('premio'),min=i.options.getInteger('minutos'),v=i.options.getInteger('vencedores'),fim=Date.now()+min*60000;const x=db.prepare('INSERT INTO giveaways(guild_id,channel_id,prize,winners,ends_at,created_by) VALUES(?,?,?,?,?,?)').run(g,i.channel.id,premio,v,fim,u);const id=x.lastInsertRowid;const m=await i.channel.send({embeds:[new EmbedBuilder().setColor(0xffc107).setTitle(`🎉 Sorteio #${id}`).setDescription(`Prêmio: **${premio}**\nReaja com 🎉 para participar.\nEncerra: <t:${Math.floor(fim/1000)}:R>\nVencedores: **${v}**`)]});await m.react('🎉');db.prepare('UPDATE giveaways SET message_id=? WHERE id=?').run(m.id,id);return i.reply({content:`Sorteio #${id} criado.`,ephemeral:true})} if(n==='sorteios'){const a=db.prepare("SELECT * FROM giveaways WHERE guild_id=? AND status='open' ORDER BY ends_at").all(g);return i.reply(a.length?a.map(x=>`**#${x.id} — ${x.prize}** · termina <t:${Math.floor(x.ends_at/1000)}:R> · ${x.winners} vencedor(es)`).join('\n'):'Nenhum sorteio ativo.')} if(n==='sorteio-encerrar'){const x=db.prepare("SELECT * FROM giveaways WHERE id=? AND guild_id=? AND status='open'").get(i.options.getInteger('id'),g);if(!x)return i.reply({content:'Sorteio não encontrado.',ephemeral:true});await i.reply({content:`Encerrando o sorteio #${x.id}...`,ephemeral:true});return finishGiveaway(x)} if(n==='avatar'){const x=i.options.getUser('usuario')||i.user;return i.reply({embeds:[new EmbedBuilder().setTitle(`Avatar de ${x.tag}`).setImage(x.displayAvatarURL({size:1024,dynamic:true}))]})} if(n==='servidor'){return i.reply({embeds:[new EmbedBuilder().setTitle(i.guild.name).setThumbnail(i.guild.iconURL()).addFields({name:'Membros',value:String(i.guild.memberCount),inline:true},{name:'Canais',value:String(i.guild.channels.cache.size),inline:true})]})} if(n==='usuario'){const m=i.options.getMember('membro')||i.member;return i.reply({embeds:[new EmbedBuilder().setTitle(m.user.tag).setThumbnail(m.user.displayAvatarURL()).addFields({name:'ID',value:m.id,inline:true},{name:'Entrou',value:`<t:${Math.floor(m.joinedTimestamp/1000)}:R>`,inline:true})]})}
if(n==='configurar-cargo-reacao'){const ch=i.options.getChannel('canal'),mid=i.options.getString('mensagem'),emoji=i.options.getString('emoji'),role=i.options.getRole('cargo');if(role.position>=i.guild.members.me.roles.highest.position)return i.reply({content:'Coloque o cargo abaixo do meu cargo.',ephemeral:true});try{const msg=await ch.messages.fetch(mid);await msg.react(emoji);db.prepare('INSERT OR REPLACE INTO reaction_roles(guild_id,channel_id,message_id,emoji,role_id) VALUES(?,?,?,?,?)').run(g,ch.id,mid,emoji,role.id);return i.reply(`Cargos por reação configurados: ${emoji} → ${role}.`)}catch{return i.reply({content:'Não consegui encontrar a mensagem ou adicionar a reação.',ephemeral:true})}} if(n==='estatisticas'){const members=i.guild.memberCount,channels=i.guild.channels.cache.size,users=db.prepare('SELECT COUNT(*) total FROM users WHERE guild_id=?').get(g).total,events=db.prepare("SELECT COUNT(*) total FROM events WHERE guild_id=? AND status='open'").get(g).total,giveaways=db.prepare("SELECT COUNT(*) total FROM giveaways WHERE guild_id=? AND status='open'").get(g).total;return i.reply({embeds:[new EmbedBuilder().setColor(0x5865f2).setTitle(`Estatísticas de ${i.guild.name}`).addFields({name:'Membros',value:String(members),inline:true},{name:'Canais',value:String(channels),inline:true},{name:'Usuários ativos',value:String(users),inline:true},{name:'Eventos abertos',value:String(events),inline:true},{name:'Sorteios ativos',value:String(giveaways),inline:true})]})} if(n==='trancar'){await i.channel.permissionOverwrites.edit(i.guild.roles.everyone,{SendMessages:false});return i.reply('🔒 Canal trancado.')} if(n==='destrancar'){await i.channel.permissionOverwrites.edit(i.guild.roles.everyone,{SendMessages:null});return i.reply('🔓 Canal destrancado.')} if(n==='modo-lento'){const sec=i.options.getInteger('segundos');await i.channel.setRateLimitPerUser(sec);return i.reply(`Modo lento definido para **${sec} segundos**.`)} if(n==='lembrete'){const min=i.options.getInteger('minutos'),msg=i.options.getString('mensagem'),due=Date.now()+min*60000;const x=db.prepare('INSERT INTO reminders(guild_id,channel_id,user_id,message,due_at) VALUES(?,?,?,?,?)').run(g,i.channel.id,u,msg,due);return i.reply({content:`Lembrete #${x.lastInsertRowid} agendado para <t:${Math.floor(due/1000)}:R>.`,ephemeral:true})} if(n==='meus-lembretes'){const a=db.prepare('SELECT id,message,due_at FROM reminders WHERE guild_id=? AND user_id=? AND sent=0 ORDER BY due_at LIMIT 20').all(g,u);return i.reply({content:a.length?a.map(x=>`**#${x.id}** · <t:${Math.floor(x.due_at/1000)}:R> · ${x.message}`).join('\n'):'Você não tem lembretes pendentes.',ephemeral:true})} if(n==='dar-cargo'||n==='remover-cargo'){const m=i.options.getMember('usuario'),r=i.options.getRole('cargo');if(!m||r.position>=i.guild.members.me.roles.highest.position)return i.reply({content:'Membro ou cargo inválido. O cargo precisa estar abaixo do meu.',ephemeral:true});if(n==='dar-cargo')await m.roles.add(r);else await m.roles.remove(r);await log(i.guild,`${n}: ${r.name} para ${m.user.tag}`);return i.reply(`${n==='dar-cargo'?'Cargo entregue':'Cargo removido'}: ${r}.`)} if(n==='apelido'){const m=i.options.getMember('usuario'),nome=i.options.getString('nome');if(!m?.manageable)return i.reply({content:'Não consigo alterar esse membro.',ephemeral:true});await m.setNickname(nome);return i.reply(`Apelido de ${m} alterado.`)} if(n==='limpar-avisos'){const t=i.options.getUser('usuario');db.prepare('DELETE FROM warnings WHERE guild_id=? AND user_id=?').run(g,t.id);return i.reply(`Avisos de ${t} removidos.`)} if(n==='silenciar'){const t=i.options.getMember('usuario'),min=i.options.getInteger('minutos'),r=i.options.getString('motivo')||'Sem motivo';if(!t?.moderatable)return i.reply({content:'Não consigo moderar esse membro.',ephemeral:true});await t.timeout(min*60000,r);return i.reply(`${t} silenciado por ${min} minutos.`)} if(n==='desilenciar'){const t=i.options.getMember('usuario');if(!t?.moderatable)return i.reply({content:'Não consigo moderar esse membro.',ephemeral:true});await t.timeout(null);return i.reply(`Silêncio removido de ${t}.`)} if(n==='ticket-assumir'){const t=db.prepare('SELECT * FROM tickets WHERE channel_id=?').get(i.channel.id);if(!t)return i.reply({content:'Use dentro de um ticket.',ephemeral:true});db.prepare('UPDATE tickets SET claimed_by=? WHERE channel_id=?').run(u,i.channel.id);return i.reply(`Ticket assumido por ${i.user}.`)} if(n==='ticket-adicionar'||n==='ticket-remover'){if(!db.prepare('SELECT 1 FROM tickets WHERE channel_id=?').get(i.channel.id))return i.reply({content:'Use dentro de um ticket.',ephemeral:true});const t=i.options.getUser('usuario');if(n==='ticket-adicionar'){await i.channel.permissionOverwrites.edit(t.id,{ViewChannel:true,SendMessages:true,ReadMessageHistory:true});return i.reply(`${t} adicionado.`)}await i.channel.permissionOverwrites.delete(t.id);return i.reply(`${t} removido.`)} if(n==='transcript'){if(!i.channel.name.startsWith('ticket-'))return i.reply({content:'Use dentro de um ticket.',ephemeral:true});const a=await i.channel.messages.fetch({limit:100}),body=[...a.values()].reverse().map(x=>`[${new Date(x.createdTimestamp).toISOString()}] ${x.author.tag}: ${x.content}`).join('\n');return i.reply({files:[{attachment:Buffer.from(body||'Sem mensagens.'),name:`${i.channel.name}.txt`}],ephemeral:true})}
if(n==='criar-call'){const me=i.guild.members.me;if(!me?.permissions.has(PermissionFlagsBits.ManageChannels))return i.reply({content:'Preciso de Gerenciar Canais.',ephemeral:true});let ch=i.guild.channels.cache.find(c=>c.type===ChannelType.GuildVoice&&c.name==='🤖 Bot Online');if(!ch)ch=await i.guild.channels.create({name:'🤖 Bot Online',type:ChannelType.GuildVoice});if(!me.permissions.has(PermissionFlagsBits.Connect))return i.reply({content:'Call criada, mas falta Conectar.',ephemeral:true});joinVoiceChannel({channelId:ch.id,guildId:g,adapterCreator:i.guild.voiceAdapterCreator,selfDeaf:true});return i.reply(`Call criada: ${ch}. O bot entrou e reconecta automaticamente quando possível.`)} if(n==='configurar-contador'){let id=db.prepare('SELECT counter_channel FROM config WHERE guild_id=?').get(g)?.counter_channel,c=id&&i.guild.channels.cache.get(id);if(!c)c=await i.guild.channels.create({name:`👥 Membros: ${i.guild.memberCount}`,type:ChannelType.GuildVoice,permissionOverwrites:[{id:i.guild.roles.everyone.id,deny:[PermissionFlagsBits.Connect]}]});else await c.setName(`👥 Membros: ${i.guild.memberCount}`);db.prepare('INSERT INTO config(guild_id,counter_channel) VALUES(?,?) ON CONFLICT(guild_id) DO UPDATE SET counter_channel=excluded.counter_channel').run(g,c.id);return i.reply(`Contador criado: ${c.name}`)} if(n==='criar-recompensa'){const name=i.options.getString('nome'),price=i.options.getInteger('preco'),r=i.options.getRole('cargo');db.prepare('INSERT INTO shop(guild_id,name,price,role_id) VALUES(?,?,?,?)').run(g,name,price,r.id);return i.reply(`Recompensa criada: ${name}.`)} if(n==='criar-missao'){db.prepare("INSERT INTO missions(guild_id,name,goal,reward,kind) VALUES(?,?,?,?, 'messages')").run(g,i.options.getString('nome'),i.options.getInteger('meta'),i.options.getInteger('recompensa'));return i.reply('Missão criada.')}
}catch(e){console.error(e);if(!i.replied&&!i.deferred)await i.reply({content:'Ocorreu um erro. Verifique as permissões do bot.',ephemeral:true})}});
client.login(token);
